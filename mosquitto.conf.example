# =============================================================================
# MOSQUITTO CONFIGURATION — EXAMPLE / TEMPLATE
# =============================================================================
# Copy this file to mosquitto.conf before running:
#   cp mosquitto.conf.example mosquitto.conf   (Linux/macOS)
#   Copy-Item mosquitto.conf.example mosquitto.conf  (Windows PowerShell)
#
# mosquitto.conf is intentionally gitignored and must NEVER be committed.
# =============================================================================
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# !! SECURITY INVARIANT — READ BEFORE EDITING                             !!
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
#   Every listener MUST include '127.0.0.1' in the listener directive.
#   This binds the socket to loopback ONLY — nothing is reachable from
#   your LAN or the internet.
#
#   DO NOT remove 127.0.0.1 from any listener unless you ALSO:
#     1. Set:   allow_anonymous false
#     2. Add:   password_file /path/to/passwd
#     3. Add:   acl_file /path/to/acl
#     4. Enable TLS:  certfile / keyfile / cafile
#
#   Removing the bind without doing all four exposes your physical
#   devices to anyone on your network with no authentication.
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!#
# MOSQUITTO VERSION NOTE:
#   Modern (1.6+): Use 'listener <port> <ip>' as shown below.
#   Legacy (<1.6): Use a top-level 'bind_address 127.0.0.1' directive instead.
#                  IMPORTANT: bind_address applies globally to ALL listeners,
#                  so a single directive protects both ports. However, you
#                  cannot have separate bind addresses per listener with this
#                  approach. Prefer upgrading to 1.6+ where possible.
#   Check your version: mosquitto --version
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# per_listener_settings true — auth/ACL settings apply only to the listener
# they are declared under. Prevents config bleed if you later add a
# password_file to one listener but not the other.
per_listener_settings true

# -----------------------------------------------------------------------------
# Standard MQTT listener — used by Python device scripts
# Port: 1883  |  Bound to: 127.0.0.1 ONLY
# -----------------------------------------------------------------------------
listener 1883 127.0.0.1
protocol mqtt
# Safe because socket is loopback-only. If you remove the bind, also set
# allow_anonymous false and add a password_file.
allow_anonymous true

# -----------------------------------------------------------------------------
# WebSocket listener — used by the browser dashboard (ws://localhost:9001)
# Port: 9001  |  Bound to: 127.0.0.1 ONLY
# -----------------------------------------------------------------------------
listener 9001 127.0.0.1
protocol websockets
allow_anonymous true

# -----------------------------------------------------------------------------
# Logging (optional — uncomment to enable)
# mosquitto.log is gitignored so it will never be committed.
# -----------------------------------------------------------------------------
# log_dest file mosquitto.log
# log_type error
# log_type warning
